# ==============================================================================
# FDR-Chain: Backend Environment Variables
# ==============================================================================

# Server configuration
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development
LOG_LEVEL=INFO

# Supabase Configuration
SUPABASE_URL=https://your-project-ref.supabase.co
# Used on the server only to verify tokens and perform admin provisioning. NEVER EXPOSE TO FRONTEND.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here
# Optional: Supabase JWT Secret for direct fast cryptographic verification of access tokens
SUPABASE_JWT_SECRET=your-supabase-jwt-secret-here

# CORS Configuration (allowed origins separated by comma)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
